@model VideoDashboard.Web.Models.VideoViewModel

@{
    ViewData["Title"] = Model.Video.Name;
}

<div class="text-center">
    <h1 class="display-4">@Model.Video.Name</h1>
    <div class="row">
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <video width="640" height="480" controls>
                        <source src="@Model.Video.VideoUri" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
                <div class="card-footer text-body-secondary">
                    <span class="badge rounded-pill bg-primary">
                        Views
                        <span class="badge bg-secondary">@Model.VideoAnalytics.Views</span>
                    </span>
                    <span class="badge rounded-pill bg-success">
                        Likes
                        <span class="badge bg-secondary">@Model.VideoAnalytics.Likes</span>
                    </span>
                    <span class="badge rounded-pill bg-danger">
                        Dislikes
                        <span class="badge bg-secondary">@Model.VideoAnalytics.Dislikes</span>
                    </span>
                </div>
                <ul class="list-group list-group-flush">
                    @if (Model.VideoAnalytics.Comments.Any())
                    {
                        @foreach (string comment in Model.VideoAnalytics.Comments)
                        {
                            <li class="list-group-item">@comment</li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item">No Comments</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>