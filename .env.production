# Production Environment Variables Template
# DO NOT commit this file with real production secrets!
# Update all placeholder values with your actual production credentials

# Service Ports
USER_SERVICE_PORT=8001
EVENT_SERVICE_PORT=8002
SEARCH_SERVICE_PORT=8003
BOOKING_SERVICE_PORT=8004

# Database URLs (update with production credentials)
USER_SERVICE_DB_URL=postgresql://USERNAME:CHANGE_THIS_PASSWORD@postgres-host:5432/users_db?sslmode=require
EVENT_SERVICE_DB_URL=postgresql://USERNAME:CHANGE_THIS_PASSWORD@postgres-host:5432/events_db?sslmode=require
BOOKING_SERVICE_DB_URL=postgresql://USERNAME:CHANGE_THIS_PASSWORD@postgres-host:5432/bookings_db?sslmode=require

# Redis
REDIS_URL=redis://redis-host:6379

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch-host:9200

# Service URLs
USER_SERVICE_URL=http://user-service:8001
EVENT_SERVICE_URL=http://event-service:8002
SEARCH_SERVICE_URL=http://search-service:8003
BOOKING_SERVICE_URL=http://booking-service:8004

# Security (generate with: openssl rand -base64 32)
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING
INTERNAL_API_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# Environment
ENVIRONMENT=production
