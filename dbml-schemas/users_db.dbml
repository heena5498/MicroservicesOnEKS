// User Service Database Schema
// Database: users_db

Project users_db {
  database_type: 'PostgreSQL'
  Note: 'User authentication and profile management database'
}

Table users {
  user_id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [unique, not null]
  phone_number varchar(20)
  name varchar(255) [not null]
  password_hash varchar(255) [not null]
  is_active boolean [default: true]
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  Note: 'Stores user account information and credentials'

  Indexes {
    email [name: 'idx_users_email']
    phone_number [name: 'idx_users_phone']
  }
}

Table refresh_tokens {
  token text [pk]
  user_id uuid [not null]
  expires_at timestamp [not null]
  revoked_at timestamp
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]

  Note: 'JWT refresh tokens for maintaining user sessions'

  Indexes {
    user_id [name: 'idx_refresh_tokens_user_id']
    (expires_at) [name: 'idx_refresh_tokens_expires', note: 'WHERE revoked_at IS NULL']
  }
}

Ref: refresh_tokens.user_id > users.user_id [delete: cascade]
